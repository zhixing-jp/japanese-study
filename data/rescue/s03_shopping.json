      "subcategory": "sub01",
      "role": "user"
    },
    {
      "jp": "少々お待ちください。確認してきます。",
      "furigana": "しょうしょうおまちください。かくにんしてきます。",
      "zh": "请稍等，我去确认一下。",
      "scene": "找商品",
      "id": "s03-006",
      "subcategory": "sub01",
      "role": "staff"
    },
    {
      "jp": "試着してもいいですか。",
      "furigana": "しちゃくしてもいいですか。",
