      "scene": "免税・优惠・包装",
      "id": "s03-014",
      "subcategory": "sub03",
      "role": "user"
    },
    {
      "jp": "ご自宅用ですか、プレゼント用ですか。",
      "furigana": "ごじたくようですか、プレゼントようですか。",
      "zh": "是自己用还是送礼用？",
      "scene": "免税・优惠・包装",
      "id": "s03-015",
      "subcategory": "sub03",
      "role": "staff"
    },
    {
      "jp": "ポイントカードはお持ちですか。",
      "furigana": "ポイントカードはおもちですか。",
      "zh": "您有积分卡吗？",
      "scene": "结账・支付",
      "id": "s03-016",
      "subcategory": "sub04",
      "role": "staff"
    },
    {
      "jp": "ポイントカードがあります。",
      "furigana": "ポイントカードがあります。",
      "zh": "我有积分卡。",
      "scene": "结账・支付",
      "id": "s03-017",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "ポイントカードはありません。",
      "furigana": "ポイントカードはありません。",
      "zh": "我没有积分卡。",
      "scene": "结账・支付",
      "id": "s03-018",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "ポイントカードを作りたいです。",
      "furigana": "ポイントカードをつくりたいです。",
      "zh": "我想办积分卡。",
      "scene": "结账・支付",
      "id": "s03-019",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "袋はご利用ですか。",
      "furigana": "ふくろはごりようですか。",
      "zh": "需要袋子吗？",
      "scene": "结账・支付",
      "id": "s03-020",
      "subcategory": "sub04",
      "role": "staff"
    },
    {
      "jp": "袋は一枚お願いします。",
      "furigana": "ふくろはいちまいおねがいします。",
      "zh": "请给我一个袋子。",
      "scene": "结账・支付",
      "id": "s03-021",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "袋はいりません。",
      "furigana": "ふくろはいりません。",
      "zh": "不需要袋子。",
      "scene": "结账・支付",
      "id": "s03-022",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "袋は有料ですか。",
      "furigana": "ふくろはゆうりょうですか。",
      "zh": "袋子要收费吗？",
      "scene": "结账・支付",
      "id": "s03-023",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "お支払いはどのようになさいますか。",
      "furigana": "おしはらいはどのようになさいますか。",
      "zh": "请问怎么付款？",
      "scene": "结账・支付",
      "id": "s03-024",
      "subcategory": "sub04",
      "role": "staff"
    },
    {
      "jp": "カードでお願いします。",
      "furigana": "カードでおねがいします。",
      "zh": "请刷卡。",
      "scene": "结账・支付",
      "id": "s03-025",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "スマホ決済は使えますか。",
      "furigana": "スマホけっさいはつかえますか。",
      "zh": "可以用手机支付吗？",
      "scene": "结账・支付",
      "id": "s03-026",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "タッチ決済できますか。",
      "furigana": "タッチけっさいできますか。",
      "zh": "可以用感应支付吗？",
      "scene": "结账・支付",
      "id": "s03-027",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "現金で払います。",
      "furigana": "げんきんではらいます。",
      "zh": "我用现金付款。",
      "scene": "结账・支付",
      "id": "s03-028",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "カードをこちらにお入れください。",
      "furigana": "カードをこちらにおいれください。",
      "zh": "请把卡插在这里。",
      "scene": "结账・支付",
      "id": "s03-029",
      "subcategory": "sub04",
      "role": "staff"
    },
    {
      "jp": "セルフレジはどこですか。",
      "furigana": "セルフレジはどこですか。",
      "zh": "自助收银台在哪里？",
      "scene": "结账・支付",
      "id": "s03-030",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "全部でいくらですか。",
      "furigana": "ぜんぶでいくらですか。",
      "zh": "一共多少钱？",
      "scene": "结账・支付",
      "id": "s03-031",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "領収書をいただけますか。",
      "furigana": "りょうしゅうしょをいただけますか。",
      "zh": "请给我发票。",
      "scene": "结账・支付",
      "id": "s03-032",
      "subcategory": "sub04",
      "role": "user"
    },
    {
      "jp": "返品できますか。レシートはこれです。",
      "furigana": "へんぴんできますか。レシートはこれです。",
      "zh": "可以退货吗？这是收据。",
      "scene": "退换货",
      "id": "s03-033",
      "subcategory": "sub05",
      "role": "user"
    },
    {
      "jp": "サイズを交換したいんですが。",
      "furigana": "サイズをこうかんしたいんですが。",
      "zh": "我想换个尺码。",
      "scene": "退换货",
      "id": "s03-034",
      "subcategory": "sub05",
      "role": "user"
    },
    {
      "jp": "壊れていました。",
      "furigana": "こわれていました。",
      "zh": "买回来是坏的。",
      "scene": "退换货",
      "id": "s03-035",
      "subcategory": "sub05",
      "role": "user"
    },
    {
      "jp": "動かないんですが。",
      "furigana": "うごかないんですが。",
      "zh": "这个没办法用。",
      "scene": "退换货",
      "id": "s03-036",
      "subcategory": "sub05",
      "role": "user"
    },
    {
      "jp": "コインロッカーはどこですか。",
      "furigana": "コインロッカーはどこですか。",
      "zh": "投币储物柜在哪里？",
      "scene": "储物柜",
      "id": "s03-037",
      "subcategory": "sub06",
      "role": "user"
    },
    {
      "jp": "使い方を教えてください。",
      "furigana": "つかいかたをおしえてください。",
      "zh": "请告诉我怎么用。",
      "scene": "储物柜",
      "id": "s03-038",
      "subcategory": "sub06",
      "role": "user"
    },
    {
      "jp": "鍵をなくしました。",
      "furigana": "かぎをなくしました。",
      "zh": "我把钥匙弄丢了。",
      "scene": "储物柜",
