      "scene": "试穿・试用",
      "id": "s03-008",
      "subcategory": "sub02",
      "role": "user"
    },
    {
      "jp": "これ、試してもいいですか。",
      "furigana": "これ、ためしてもいいですか。",
      "zh": "这个可以试用吗？",
      "scene": "试穿・试用",
      "id": "s03-009",
      "subcategory": "sub02",
      "role": "user"
    },
    {
      "jp": "サイズはいかがですか。",
      "furigana": "サイズはいかがですか。",
      "zh": "尺码合适吗？",
      "scene": "试穿・试用",
      "id": "s03-010",
      "subcategory": "sub02",
      "role": "staff"
    },
    {
      "jp": "免税手続きはできますか。",
      "furigana": "めんぜいてつづきはできますか。",
