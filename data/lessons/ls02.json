{
  "id": "ls02",
  "title": "超市结账",
  "title_ja": "スーパー",
  "emoji": "🛒",
  "level": "lv1",
  "sound": "supermarket",
  "description": "你在超市买好了东西，走向收银台。",
  "basic": {
    "title": "基本结账流程",
    "dialog": [
      {
        "id": "ls02-b01",
        "speaker": "you",
        "jp": "すみません、セルフレジはどこですか。",
        "zh": "不好意思，自助收银台在哪里？",
        "note": "找不到自助收银台时才需要问。",
        "pause": 2500
      },
      {
        "id": "ls02-b02",
        "speaker": "them",
        "jp": "ポイントカードはお持ちですか。",
        "zh": "有积分卡吗？",
        "pause": 1500
      },
      {
        "id": "ls02-b03",
        "speaker": "you",
        "jp": "はい、あります。／いいえ、ありません。",
        "zh": "有的。／没有。",
        "pause": 2500
      },
      {
        "id": "ls02-b04",
        "speaker": "them",
        "jp": "袋はご利用ですか。",
        "zh": "需要袋子吗？",
        "pause": 1500
      },
      {
        "id": "ls02-b05",
        "speaker": "you",
        "jp": "いりません。／小さいのをください。／大きいのをください。",
        "zh": "不需要。／请给我小袋子。／请给我大袋子。",
        "pause": 2500
      },
      {
        "id": "ls02-b06",
        "speaker": "them",
        "jp": "○○円になります。",
        "zh": "一共○○日元。",
        "pause": 1500
      },
      {
        "id": "ls02-b07",
        "speaker": "you",
        "jp": "カードで。／バーコードで。／タッチで。",
        "zh": "刷卡。／扫码付款。／感应付款。",
        "note": "现金：把钱递过去，不需要说话。",
        "pause": 2500
      },
      {
        "id": "ls02-b08",
        "speaker": "them",
        "jp": "ありがとうございました。",
        "zh": "谢谢惠顾。",
        "pause": 1500
      },
      {
        "id": "ls02-b09",
        "speaker": "you",
        "jp": "ありがとうございます。",
        "zh": "谢谢。",
        "note": "或点头微笑离开就好。",
        "pause": 2000
      }
    ]
  },
  "extensions": [
    {
      "id": "ls02-ex01",
      "title": "便当加热",
      "dialog": [
        {
          "id": "ls02-ex01-01",
          "speaker": "them",
          "jp": "温めますか。",
          "zh": "要加热吗？",
          "pause": 1500
        },
        {
          "id": "ls02-ex01-02",
          "speaker": "you",
          "jp": "はい、お願いします。／いいえ、大丈夫です。",
          "zh": "是的，麻烦了。／不用，没关系。",
          "pause": 2500
        }
      ]
    },
    {
      "id": "ls02-ex02",
      "title": "退换货",
      "dialog": [
        {
          "id": "ls02-ex02-01",
          "speaker": "you",
          "jp": "すみません、これを返品したいんですが。",
          "zh": "不好意思，我想退这个。",
          "pause": 2500
        },
        {
          "id": "ls02-ex02-02",
          "speaker": "them",
          "jp": "レシートはお持ちですか。",
          "zh": "有收据吗？",
          "pause": 1500
        },
        {
          "id": "ls02-ex02-03",
          "speaker": "you",
          "jp": "はい、あります。／いいえ、ありません。",
          "zh": "有的。／没有。",
          "pause": 2500
        },
        {
          "id": "ls02-ex02-04",
          "speaker": "you",
          "jp": "交換したいんですが。",
          "zh": "我想换货。",
          "pause": 2500
        },
        {
          "id": "ls02-ex02-05",
          "speaker": "you",
          "jp": "壊れていたんです。",
          "zh": "买回来是坏的。",
          "pause": 2500
        }
      ]
    }
  ]
}
