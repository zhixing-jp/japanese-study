{
  "id": "ls06",
  "title": "餐厅",
  "title_ja": "レストラン",
  "emoji": "🍜",
  "level": "lv2",
  "sound": "default",
  "description": "你在餐厅用餐，从入店到结账。",
  "basic": {
    "title": "入店到结账",
    "dialog": [
      {
        "id": "ls06-b01",
        "speaker": "them",
        "jp": "何名様ですか。",
        "zh": "请问几位？",
        "pause": 1500
      },
      {
        "id": "ls06-b02",
        "speaker": "you",
        "jp": "一人です。／二人です。／三人です。",
        "zh": "一位。／两位。／三位。",
        "pause": 2500
      },
      {
        "id": "ls06-b03",
        "speaker": "them",
        "jp": "こちらへどうぞ。",
        "zh": "请往这边走。",
        "note": "点头跟着走就好。",
        "pause": 1500
      },
      {
        "id": "ls06-b04",
        "speaker": "them",
        "jp": "ご注文はお決まりですか。",
        "zh": "请问点好了吗？",
        "pause": 1500
      },
      {
        "id": "ls06-b05",
        "speaker": "you",
        "jp": "もう少し待ってください。／はい、お願いします。",
        "zh": "请再等一下。／好了，麻烦您。",
        "pause": 2500
      },
      {
        "id": "ls06-b06",
        "speaker": "you",
        "jp": "これをください。",
        "zh": "我要这个。",
        "note": "指着菜单说就好。",
        "pause": 2500
      },
      {
        "id": "ls06-b07",
        "speaker": "you",
        "jp": "○○なしでお願いします。",
        "zh": "请不要放○○。",
        "pause": 2500
      },
      {
        "id": "ls06-b08",
        "speaker": "you",
        "jp": "○○アレルギーがあります。",
        "zh": "我对○○过敏。",
        "pause": 2500
      },
      {
        "id": "ls06-b09",
        "speaker": "you",
        "jp": "お会計をお願いします。",
        "zh": "请结账。",
        "pause": 2500
      },
      {
        "id": "ls06-b10",
        "speaker": "them",
        "jp": "○○円になります。",
        "zh": "一共○○日元。",
        "pause": 1500
      },
      {
        "id": "ls06-b11",
        "speaker": "you",
        "jp": "別々でお願いします。／一緒でお願いします。",
        "zh": "请分开结账。／请一起结账。",
        "pause": 2500
      },
      {
        "id": "ls06-b12",
        "speaker": "you",
        "jp": "カードで。／バーコードで。／タッチで。",
        "zh": "刷卡。／扫码付款。／感应付款。",
        "pause": 2500
      }
    ]
  },
  "extensions": [
    {
      "id": "ls06-ex01",
      "title": "预约",
      "dialog": [
        {
          "id": "ls06-ex01-01",
          "speaker": "you",
          "jp": "予約をしたいんですが。",
          "zh": "我想预约。",
          "pause": 2500
        },
        {
          "id": "ls06-ex01-02",
          "speaker": "them",
          "jp": "何名様ですか。",
          "zh": "几位？",
          "pause": 1500
        },
        {
          "id": "ls06-ex01-03",
          "speaker": "you",
          "jp": "○名です。",
          "zh": "○位。",
          "pause": 2500
        },
        {
          "id": "ls06-ex01-04",
          "speaker": "them",
          "jp": "何日の何時ですか。",
          "zh": "几月几日几点？",
          "pause": 1500
        },
        {
          "id": "ls06-ex01-05",
          "speaker": "you",
          "jp": "○月○日の○時です。",
          "zh": "○月○日○点。",
          "pause": 2500
        },
        {
          "id": "ls06-ex01-06",
          "speaker": "them",
          "jp": "お名前をお願いします。",
          "zh": "请告诉我您的姓名。",
          "pause": 1500
        },
        {
          "id": "ls06-ex01-07",
          "speaker": "you",
          "jp": "○○です。",
          "zh": "我叫○○。",
          "pause": 2500
        }
      ]
    },
    {
      "id": "ls06-ex02",
      "title": "外带打包",
      "dialog": [
        {
          "id": "ls06-ex02-01",
          "speaker": "you",
          "jp": "持ち帰りをお願いします。",
          "zh": "我要外带。",
          "pause": 2500
        },
        {
          "id": "ls06-ex02-02",
          "speaker": "you",
          "jp": "残りを包んでもらえますか。",
          "zh": "可以帮我把剩下的打包吗？",
          "pause": 2500
        },
        {
          "id": "ls06-ex02-03",
          "speaker": "them",
          "jp": "少々お待ちください。",
          "zh": "请稍等。",
          "pause": 1500
        }
      ]
    },
    {
      "id": "ls06-ex03",
      "title": "食券机",
      "dialog": [
        {
          "id": "ls06-ex03-01",
          "speaker": "you",
          "jp": "使い方を教えてください。",
          "zh": "请告诉我怎么用。",
          "pause": 2500
        },
        {
          "id": "ls06-ex03-02",
          "speaker": "you",
          "jp": "現金しか使えませんか。",
          "zh": "只能用现金吗？",
          "pause": 2500
        },
        {
          "id": "ls06-ex03-03",
          "speaker": "you",
          "jp": "これでいいですか。",
          "zh": "这样可以吗？",
          "pause": 2500
        },
        {
          "id": "ls06-ex03-04",
          "speaker": "them",
          "jp": "はい、大丈夫です。",
          "zh": "是的，没问题。",
          "pause": 1500
        }
      ]
    }
  ]
}
