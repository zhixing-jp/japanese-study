{
  "id": "ls05",
  "title": "坐出租车",
  "title_ja": "タクシー",
  "emoji": "🚕",
  "level": "lv1",
  "sound": "default",
  "description": "你要坐出租车去目的地。",
  "basic": {
    "title": "上车到下车",
    "dialog": [
      {
        "id": "ls05-b01",
        "speaker": "you",
        "jp": "○○までお願いします。",
        "zh": "请送我去○○。",
        "pause": 2500
      },
      {
        "id": "ls05-b02",
        "speaker": "you",
        "jp": "この住所までお願いします。",
        "zh": "请送我去这个地址。",
        "note": "把手机地图或纸条递给司机。",
        "pause": 2500
      },
      {
        "id": "ls05-b03",
        "speaker": "you",
        "jp": "次の信号で止めてください。",
        "zh": "请在下一个红绿灯停车。",
        "pause": 2500
      },
      {
        "id": "ls05-b04",
        "speaker": "you",
        "jp": "ここで止めてください。",
        "zh": "请在这里停车。",
        "pause": 2500
      },
      {
        "id": "ls05-b05",
        "speaker": "them",
        "jp": "○○円になります。",
        "zh": "到了，○○日元。",
        "note": "付钱就好，现金／卡／感应均可。",
        "pause": 1500
      },
      {
        "id": "ls05-b06",
        "speaker": "you",
        "jp": "領収書をください。",
        "zh": "请给我收据。",
        "pause": 2500
      }
    ]
  },
  "extensions": [
    {
      "id": "ls05-ex01",
      "title": "行李",
      "dialog": [
        {
          "id": "ls05-ex01-01",
          "speaker": "you",
          "jp": "トランクを開けてください。",
          "zh": "请打开后备箱。",
          "pause": 2500
        },
        {
          "id": "ls05-ex01-02",
          "speaker": "them",
          "jp": "どうぞ。",
          "zh": "请。",
          "pause": 1500
        },
        {
          "id": "ls05-ex01-03",
          "speaker": "you",
          "jp": "トランクをお願いします。",
          "zh": "麻烦帮我开一下后备箱。",
          "pause": 2500
        }
      ]
    },
    {
      "id": "ls05-ex02",
      "title": "找出租车",
      "dialog": [
        {
          "id": "ls05-ex02-01",
          "speaker": "you",
          "jp": "タクシー乗り場はどこですか。",
          "zh": "出租车站在哪里？",
          "pause": 2500
        },
        {
          "id": "ls05-ex02-02",
          "speaker": "you",
          "jp": "タクシーを呼んでもらえますか。",
          "zh": "可以帮我叫出租车吗？",
          "pause": 2500
        },
        {
          "id": "ls05-ex02-03",
          "speaker": "them",
          "jp": "少々お待ちください。",
          "zh": "请稍等。",
          "pause": 1500
        }
      ]
    }
  ]
}
