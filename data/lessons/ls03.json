{
  "id": "ls03",
  "title": "坐电车",
  "title_ja": "電車",
  "emoji": "🚃",
  "level": "lv1",
  "sound": "train",
  "description": "你要坐电车去目的地。",
  "basic": {
    "title": "从买票到出站",
    "dialog": [
      {
        "id": "ls03-b01",
        "speaker": "you",
        "jp": "ICカードをください。",
        "zh": "请给我一张IC卡。",
        "note": "在服务台购买。",
        "pause": 2500
      },
      {
        "id": "ls03-b02",
        "speaker": "you",
        "jp": "チャージしたいんですが。",
        "zh": "我想充值。",
        "pause": 2500
      },
      {
        "id": "ls03-b03",
        "speaker": "you",
        "jp": "○○円チャージしてください。",
        "zh": "请充值○○日元。",
        "pause": 2500
      },
      {
        "id": "ls03-b04",
        "speaker": "you",
        "jp": "すみません、○○行きはどちらですか。",
        "zh": "不好意思，去○○方向的在哪边？",
        "pause": 2500
      },
      {
        "id": "ls03-b05",
        "speaker": "them",
        "jp": "○番線です。",
        "zh": "在○号线。",
        "pause": 1500
      },
      {
        "id": "ls03-b06",
        "speaker": "you",
        "jp": "すみません、この電車は○○に止まりますか。",
        "zh": "不好意思，这趟电车停○○吗？",
        "pause": 2500
      },
      {
        "id": "ls03-b07",
        "speaker": "them",
        "jp": "はい、止まりますよ。／いいえ、止まりません。",
        "zh": "是的，停的。／不停的。",
        "pause": 1500
      },
      {
        "id": "ls03-b08",
        "speaker": "you",
        "jp": "すみません、○○へはどこで乗り換えますか。",
        "zh": "不好意思，去○○在哪里换乘？",
        "pause": 2500
      },
      {
        "id": "ls03-b09",
        "speaker": "them",
        "jp": "○○駅で乗り換えてください。",
        "zh": "在○○站换乘。",
        "pause": 1500
      }
    ]
  },
  "extensions": [
    {
      "id": "ls03-ex01",
      "title": "出站异常",
      "dialog": [
        {
          "id": "ls03-ex01-01",
          "speaker": "you",
          "jp": "すみません、乗り間違えてしまいました。どうすればいいですか。",
          "zh": "不好意思，我坐错车了。应该怎么办？",
          "pause": 2500
        },
        {
          "id": "ls03-ex01-02",
          "speaker": "you",
          "jp": "残高が足りないようで。チャージしたいんですが。",
          "zh": "好像余额不足了。我想充值。",
          "pause": 2500
        },
        {
          "id": "ls03-ex01-03",
          "speaker": "you",
          "jp": "すみません、入場記録を取り消していただけますか。",
          "zh": "不好意思，能帮我取消入站记录吗？",
          "pause": 2500
        }
      ]
    },
    {
      "id": "ls03-ex02",
      "title": "末班车",
      "dialog": [
        {
          "id": "ls03-ex02-01",
          "speaker": "you",
          "jp": "すみません、○○行きの終電は何時ですか。",
          "zh": "不好意思，去○○方向的末班车是几点？",
          "pause": 2500
        },
        {
          "id": "ls03-ex02-02",
          "speaker": "them",
          "jp": "○時○分です。",
          "zh": "是○点○分。",
          "pause": 1500
        }
      ]
    },
    {
      "id": "ls03-ex03",
      "title": "遗失物",
      "dialog": [
        {
          "id": "ls03-ex03-01",
          "speaker": "you",
          "jp": "電車の中に忘れ物をしてしまいました。",
          "zh": "我把东西忘在电车上了。",
          "pause": 2500
        },
        {
          "id": "ls03-ex03-02",
          "speaker": "them",
          "jp": "何をお忘れになりましたか。",
          "zh": "您忘了什么？",
          "pause": 1500
        },
        {
          "id": "ls03-ex03-03",
          "speaker": "you",
          "jp": "○○を忘れました。",
          "zh": "我忘了○○。",
          "pause": 2500
        },
        {
          "id": "ls03-ex03-04",
          "speaker": "you",
          "jp": "○時頃の○○行きです。",
          "zh": "是○点左右去○○方向的。",
          "pause": 2500
        }
      ]
    }
  ]
}
