    {
      "id": "s06",
      "file": "data/sos/s06_medical.json",
      "title": "受診",
      "title_zh": "看病",
      "image": "assets/sos/scenes/medical.webp",
      "description": "从预约到取药，成功看到医生所需的句子。",
      "info": [
    {
      "title": "在日本看病，有三种方式：",
      "lines": [
        "诊所（クリニック）：适合轻症，部分可直接去无需预约",
        "医院（病院）：适合慢性病复诊或需要专科检查",
        "急诊（救急）：严重症状拨打119，或前往救急医院"
      ]
    },
    {
      "title": "常见科室：",
      "lines": [
        "内科：发烧、感冒、腹痛等一般症状",
        "外科：外伤、手术（≠中文外科，不含骨科）",
        "整形外科：骨折、关节、肌肉问题（≠中文整形，是骨科）",
        "皮膚科：皮肤问题",
        "眼科：眼睛问题",
        "耳鼻咽喉科：耳鼻喉问题",
        "歯科・口腔外科：牙齿、口腔问题",
        "小児科：儿童看诊（14岁以下）",
        "産婦人科：妇科、产科",
        "泌尿器科：泌尿系统问题",
        "循環器科：心脏、血管问题",
        "精神科・心療内科：心理、精神健康"
      ]
    },
    {
      "title": "就诊流程：",
      "lines": [
        "预约（网络或电话）→ 挂号（受付）→ 候诊室等待",
        "→ 医生问诊 → 缴费 → 凭处方笺去附近药局取药"
      ]
    },
    {
      "title": "需要准备：",
      "lines": [
        "健康保険証（医保卡）或マイナンバーカード",
        "初诊需填写问诊表（問診票）",
        "处方笺可在医院附近任意调剂药局使用"
      ]
    }
  ],
