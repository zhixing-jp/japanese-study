{
  "id": "s06",
  "title": "受診",
  "title_zh": "看病",
  "category": "看病",
  "description": "从预约到取药，成功看到医生所需的句子。",
  "items": [
    {
      "jp": "予約をしたいです。",
      "furigana": "よやくをしたいです。",
      "zh": "我想预约。",
      "scene": "预约",
      "id": "s06-001",
      "subcategory": "sub01"
    },
    {
      "jp": "○○科を受診したいです。",
      "furigana": "○○かをじゅしんしたいです。",
      "zh": "我想看○○科。",
      "scene": "预约",
      "id": "s06-002",
      "subcategory": "sub01"
    },
    {
      "jp": "初めてです。",
      "furigana": "はじめてです。",
      "zh": "我是第一次来。",
      "scene": "预约",
      "id": "s06-003",
      "subcategory": "sub01"
    },
    {
      "jp": "何日の何時が空いていますか。",
      "furigana": "なんにちのなんじがあいていますか。",
      "zh": "哪天几点有空档？",
      "scene": "预约",
      "id": "s06-004",
      "subcategory": "sub01"
    },
    {
      "jp": "予約を変更したいです。",
      "furigana": "よやくをへんこうしたいです。",
      "zh": "我想更改预约时间。",
      "scene": "预约",
      "id": "s06-005",
      "subcategory": "sub01"
    },
    {
      "jp": "予約をキャンセルしたいです。",
      "furigana": "よやくをキャンセルしたいです。",
      "zh": "我想取消预约。",
      "scene": "预约",
      "id": "s06-006",
      "subcategory": "sub01"
    },
    {
      "jp": "予約しています。李と申します。",
      "furigana": "よやくしています。りともうします。",
      "zh": "我有预约，我姓李。",
      "scene": "挂号・初诊",
      "id": "s06-007",
      "subcategory": "sub01"
    },
    {
      "jp": "保険証はこちらです。",
      "furigana": "ほけんしょうはこちらです。",
      "zh": "这是我的医保卡。",
      "scene": "挂号・初诊",
      "id": "s06-008",
      "subcategory": "sub02"
    },
    {
      "jp": "マイナ保険証です。",
      "furigana": "マイナほけんしょうです。",
      "zh": "这是我的My Number医保卡。",
      "scene": "挂号・初诊",
      "id": "s06-009",
      "subcategory": "sub02"
    },
    {
      "jp": "保険証がありません。",
      "furigana": "ほけんしょうがありません。",
      "zh": "我没有医保卡。",
      "scene": "挂号・初诊",
      "id": "s06-010",
      "subcategory": "sub02"
    },
    {
      "jp": "問診票の書き方を教えてください。",
      "furigana": "もんしんひょうのかきかたをおしえてください。",
      "zh": "请告诉我问诊表怎么填。",
      "scene": "挂号・初诊",
      "id": "s06-011",
      "subcategory": "sub02"
    },
    {
      "jp": "中国語の通訳はいますか。",
      "furigana": "ちゅうごくごのつうやくはいますか。",
      "zh": "有中文翻译吗？",
      "scene": "挂号・初诊",
      "id": "s06-012",
      "subcategory": "sub02"
    },
    {
      "jp": "ここが痛いです。",
      "furigana": "ここがいたいです。",
      "zh": "这里疼。",
      "scene": "说明症状",
      "id": "s06-013",
      "subcategory": "sub03"
    },
    {
      "jp": "頭が痛いです。",
      "furigana": "あたまがいたいです。",
      "zh": "头痛。",
      "scene": "说明症状",
      "id": "s06-014",
      "subcategory": "sub03"
    },
    {
      "jp": "お腹が痛いです。",
      "furigana": "おなかがいたいです。",
      "zh": "肚子疼。",
      "scene": "说明症状",
      "id": "s06-015",
      "subcategory": "sub03"
    },
    {
      "jp": "胸が痛いです。",
      "furigana": "むねがいたいです。",
      "zh": "胸口疼。",
      "scene": "说明症状",
      "id": "s06-016",
      "subcategory": "sub03"
    },
    {
      "jp": "背中が痛いです。",
      "furigana": "せなかがいたいです。",
      "zh": "背部疼。",
      "scene": "说明症状",
      "id": "s06-017",
      "subcategory": "sub03"
    },
    {
      "jp": "喉が痛いです。",
      "furigana": "のどがいたいです。",
      "zh": "喉咙痛。",
      "scene": "说明症状",
      "id": "s06-018",
      "subcategory": "sub03"
    },
    {
      "jp": "熱があります。",
      "furigana": "ねつがあります。",
      "zh": "发烧了。",
      "scene": "说明症状",
      "id": "s06-019",
      "subcategory": "sub03"
    },
    {
      "jp": "咳が止まりません。",
      "furigana": "せきがとまりません。",
      "zh": "咳嗽不停。",
      "scene": "说明症状",
      "id": "s06-020",
      "subcategory": "sub03"
    },
    {
      "jp": "鼻水が出ます。",
      "furigana": "はなみずがでます。",
      "zh": "流鼻涕。",
      "scene": "说明症状",
      "id": "s06-021",
      "subcategory": "sub03"
    },
    {
      "jp": "吐き気がします。",
      "furigana": "はきけがします。",
      "zh": "感到恶心。",
      "scene": "说明症状",
      "id": "s06-022",
      "subcategory": "sub03"
    },
    {
      "jp": "嘔吐しました。",
      "furigana": "おうとしました。",
      "zh": "呕吐了。",
      "scene": "说明症状",
      "id": "s06-023",
      "subcategory": "sub03"
    },
    {
      "jp": "下痢をしています。",
      "furigana": "げりをしています。",
      "zh": "拉肚子。",
      "scene": "说明症状",
      "id": "s06-024",
      "subcategory": "sub03"
    },
    {
      "jp": "めまいがします。",
      "furigana": "めまいがします。",
      "zh": "头晕。",
      "scene": "说明症状",
      "id": "s06-025",
      "subcategory": "sub03"
    },
    {
      "jp": "動悸がします。",
      "furigana": "どうきがします。",
      "zh": "心跳加速。",
      "scene": "说明症状",
      "id": "s06-026",
      "subcategory": "sub03"
    },
    {
      "jp": "息が苦しいです。",
      "furigana": "いきがくるしいです。",
      "zh": "呼吸困难。",
      "scene": "说明症状",
      "id": "s06-027",
      "subcategory": "sub03"
    },
    {
      "jp": "○日前からです。",
      "furigana": "○にちまえからです。",
      "zh": "从○天前开始。",
      "scene": "说明症状",
      "id": "s06-028",
      "subcategory": "sub03"
    },
    {
      "jp": "だんだん悪くなっています。",
      "furigana": "だんだんわるくなっています。",
      "zh": "越来越严重。",
      "scene": "说明症状",
      "id": "s06-029",
      "subcategory": "sub03"
    },
    {
      "jp": "アレルギーがあります。",
      "furigana": "アレルギーがあります。",
      "zh": "我有过敏。",
      "scene": "说明症状",
      "id": "s06-030",
      "subcategory": "sub03"
    },
    {
      "jp": "薬を飲んでいます。",
      "furigana": "くすりをのんでいます。",
      "zh": "我正在吃药。",
      "scene": "说明症状",
      "id": "s06-031",
      "subcategory": "sub03"
    },
    {
      "jp": "持病があります。",
      "furigana": "じびょうがあります。",
      "zh": "我有慢性病。",
      "scene": "说明症状",
      "id": "s06-032",
      "subcategory": "sub03"
    },
    {
      "jp": "妊娠しているかもしれません。",
      "furigana": "にんしんしているかもしれません。",
      "zh": "我可能怀孕了。",
      "scene": "说明症状",
      "id": "s06-033",
      "subcategory": "sub03"
    },
    {
      "jp": "検査が必要ですか。",
      "furigana": "けんさがひつようですか。",
      "zh": "需要做检查吗？",
      "scene": "问诊中・检查",
      "id": "s06-034",
      "subcategory": "sub04"
    },
    {
      "jp": "入院が必要ですか。",
      "furigana": "にゅういんがひつようですか。",
      "zh": "需要住院吗？",
      "scene": "问诊中・检查",
      "id": "s06-035",
      "subcategory": "sub04"
    },
    {
      "jp": "どのくらいで治りますか。",
      "furigana": "どのくらいでなおりますか。",
      "zh": "大概多久能好？",
      "scene": "问诊中・检查",
      "id": "s06-036",
      "subcategory": "sub04"
    },
    {
      "jp": "仕事はできますか。",
      "furigana": "しごとはできますか。",
      "zh": "可以上班吗？",
      "scene": "问诊中・检查",
      "id": "s06-037",
      "subcategory": "sub04"
    },
    {
      "jp": "次はいつ来ればいいですか。",
      "furigana": "つぎはいつくればいいですか。",
      "zh": "下次什么时候来？",
      "scene": "问诊中・检查",
      "id": "s06-038",
      "subcategory": "sub04"
    },
    {
      "jp": "診断書をお願いできますか。",
      "furigana": "しんだんしょをおねがいできますか。",
      "zh": "可以开诊断书吗？",
      "scene": "问诊中・检查",
      "id": "s06-039",
      "subcategory": "sub04"
    },
    {
      "jp": "保険は使えますか。",
      "furigana": "ほけんはつかえますか。",
      "zh": "可以用医保吗？",
      "scene": "付款・结账",
      "id": "s06-040",
      "subcategory": "sub04"
    },
    {
      "jp": "領収書をください。",
      "furigana": "りょうしゅうしょをください。",
      "zh": "请给我收据。",
      "scene": "付款・结账",
      "id": "s06-041",
      "subcategory": "sub04"
    },
    {
      "jp": "薬の飲み方を教えてください。",
      "furigana": "くすりののみかたをおしえてください。",
      "zh": "请告诉我怎么服药。",
      "scene": "取药・问用法",
      "id": "s06-042",
      "subcategory": "sub05"
    },
    {
      "jp": "1日何回ですか。",
      "furigana": "いちにちなんかいですか。",
      "zh": "一天几次？",
      "scene": "取药・问用法",
      "id": "s06-043",
      "subcategory": "sub05"
    },
    {
      "jp": "食前ですか、食後ですか。",
      "furigana": "しょくぜんですか、しょくごですか。",
      "zh": "饭前还是饭后吃？",
      "scene": "取药・问用法",
      "id": "s06-044",
      "subcategory": "sub05"
    },
    {
      "jp": "副作用はありますか。",
      "furigana": "ふくさようはありますか。",
      "zh": "有副作用吗？",
      "scene": "取药・问用法",
      "id": "s06-045",
      "subcategory": "sub05"
    },
    {
      "jp": "子供でも飲めますか。",
      "furigana": "こどもでものめますか。",
      "zh": "小孩也可以吃吗？",
      "scene": "取药・问用法",
      "id": "s06-046",
      "subcategory": "sub05"
    },
    {
      "jp": "妊娠中でも大丈夫ですか。",
      "furigana": "にんしんちゅうでもだいじょうぶですか。",
      "zh": "孕期也可以用吗？",
      "scene": "取药・问用法",
      "id": "s06-047",
      "subcategory": "sub05"
    },
    {
      "jp": "この処方箋をお願いします。",
      "furigana": "このしょほうせんをおねがいします。",
      "zh": "请帮我配这个处方。",
      "scene": "药局",
      "id": "s06-048",
      "subcategory": "sub05"
    },
    {
      "jp": "どのくらい待ちますか。",
      "furigana": "どのくらいまちますか。",
      "zh": "大概要等多久？",
      "scene": "药局",
      "id": "s06-049",
      "subcategory": "sub05"
    },
    {
      "jp": "ジェネリックにできますか。",
      "furigana": "ジェネリックにできますか。",
      "zh": "可以换成仿制药吗？",
      "scene": "药局",
      "id": "s06-050",
      "subcategory": "sub05"
    },
    {
      "jp": "風邪薬はどこですか。",
      "furigana": "かぜぐすりはどこですか。",
      "zh": "感冒药在哪里？",
      "scene": "药局",
      "id": "s06-051",
      "subcategory": "sub05"
    },
    {
      "jp": "解熱剤はありますか。",
      "furigana": "げねつざいはありますか。",
      "zh": "有退烧药吗？",
      "scene": "药局",
      "id": "s06-052",
      "subcategory": "sub05"
    },
    {
      "jp": "お薬手帳があります。",
      "furigana": "おくすりてちょうがあります。",
      "zh": "我有用药手册。",
      "scene": "药局",
      "id": "s06-053",
      "subcategory": "sub05"
    },
    {
      "jp": "子供の診察をお願いします。",
      "furigana": "こどものしんさつをおねがいします。",
      "zh": "请帮孩子看诊。",
      "scene": "儿科・孩子看病",
      "id": "s06-054",
      "subcategory": "sub06"
    },
    {
      "jp": "3歳です。",
      "furigana": "3さいです。",
      "zh": "3岁。",
      "scene": "儿科・孩子看病",
      "id": "s06-055",
      "subcategory": "sub06"
    },
    {
      "jp": "熱が38度5分あります。",
      "furigana": "ねつが38ど5ぶあります。",
      "zh": "发烧38.5度。",
      "scene": "儿科・孩子看病",
      "id": "s06-056",
      "subcategory": "sub06"
    },
    {
      "jp": "昨夜から熱が下がりません。",
      "furigana": "さくやからねつがさがりません。",
      "zh": "从昨晚开始烧不退。",
      "scene": "儿科・孩子看病",
      "id": "s06-057",
      "subcategory": "sub06"
    },
    {
      "jp": "発疹が出ています。",
      "furigana": "はっしんがでています。",
      "zh": "出疹子了。",
      "scene": "儿科・孩子看病",
      "id": "s06-058",
      "subcategory": "sub06"
    },
    {
      "jp": "食欲がありません。",
      "furigana": "しょくよくがありません。",
      "zh": "没有食欲。",
      "scene": "儿科・孩子看病",
      "id": "s06-059",
      "subcategory": "sub06"
    },
    {
      "jp": "ぐったりしています。",
      "furigana": "ぐったりしています。",
      "zh": "无精打采。",
      "scene": "儿科・孩子看病",
      "id": "s06-060",
      "subcategory": "sub06"
    }
  ]
}