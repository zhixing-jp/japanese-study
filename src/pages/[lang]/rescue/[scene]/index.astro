---
import Base from '../../../../layouts/Base.astro';
import rescueIndex from '../../../../../public/data/rescue/index.json';
import { readFile } from 'node:fs/promises';

export async function getStaticPaths() {
  const SUPPORTED_LANGS = ['zh-TW', 'en', 'vi', 'ko', 'ja'];
  const paths = [];
  for (const scene of rescueIndex.scenes) {
    for (const lang of SUPPORTED_LANGS) {
      paths.push({
        params: { lang, scene: scene.id },
        props: { scene, lang }
      });
    }
  }
  return paths;
}

const { scene, lang } = Astro.props;

const sceneTitle = (scene as any)[`title_${lang}`] || (scene as any).title_zh || scene.title;
const sceneDesc = (scene as any)[`description_${lang}`] || scene.description || '';
const subcats = scene.subcategories || [];
const info = (scene as any).info || [];
const categoryIcons: Record<string, string> = {
  daily: '📌', medical: '🏥', living: '🏠', transport: '🚗',
  shopping: '🛍️', work: '💼', leisure: '🎌', emergency: '🆘'
};
const sceneIcon = categoryIcons[(scene as any).category] || '📍';

const homeUrl = `/${lang}/`;
const homeLabel: Record<string, string> = {
  zh: '首页', en: 'Home', 'zh-TW': '首頁', vi: 'Trang chủ', ko: '홈', ja: 'ホーム'
};

const infoToggleLabel: Record<string, { open: string; close: string }> = {
  zh:     { open: '∨ 点击打开', close: '∧ 点击折叠' },
  en:     { open: '∨ Tap to open', close: '∧ Tap to close' },
  'zh-TW':{ open: '∨ 點擊打開', close: '∧ 點擊折疊' },
  vi:     { open: '∨ Nhấn để mở', close: '∧ Nhấn để đóng' },
  ko:     { open: '∨ 눌러서 열기', close: '∧ 눌러서 닫기' },
  ja:     { open: '∨ タップして開く', close: '∧ タップして閉じる' }
};
const toggleOpen = infoToggleLabel[lang]?.open || infoToggleLabel.zh.open;
const toggleClose = infoToggleLabel[lang]?.close || infoToggleLabel.zh.close;

function getSubTitle(sub: any, lang: string): string {
  return sub[`title_${lang}`] || sub.title || '';
}
function getInfoTitle(sec: any, lang: string): string {
  return sec[`title_${lang}`] || sec.title || '';
}
function getInfoLines(sec: any, lang: string): string[] {
  return sec[`lines_${lang}`] || sec.lines || [];
}

const hasGroups = subcats.some((sub: any) => sub.group);
const groups: Record<string, any[]> = {};
if (hasGroups) {
  subcats.forEach((sub: any) => {
    const key = sub.group || 'other';
    if (!groups[key]) groups[key] = [];
    groups[key].push(sub);
  });
}
---

<Base title={`${sceneTitle} | Living Japanese`} description={sceneDesc} rescueCss={true}>

  <nav class="rescue-breadcrumb" aria-label="breadcrumb">
    <a href={homeUrl}>{homeLabel[lang] || homeLabel.zh}</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">{sceneTitle}</span>
  </nav>

  <div class="rescue-scene-landing">
    <div class="rescue-landing-hero">
      <div class="rescue-landing-hero-text">
        <div class="rescue-landing-title-hero">{sceneTitle}</div>
        <div class="rescue-landing-desc-hero">{sceneDesc}</div>
      </div>
      <span class="rescue-landing-icon" aria-hidden="true">{sceneIcon}</span>
    </div>

    {info.length > 0 && (
      <div class="scene-info-wrap" id="sceneInfoWrap">
        <div class="scene-info" id="sceneInfo"
          style="cursor:pointer"
          data-open-label={toggleOpen}
          data-close-label={toggleClose}
          onclick="this.classList.toggle('expanded'); this.nextElementSibling.textContent = this.classList.contains('expanded') ? this.dataset.closeLabel : this.dataset.openLabel;">
          {info.map((sec: any) => (
            <div class="scene-info-section">
              <div class="scene-info-title">{getInfoTitle(sec, lang)}</div>
              <div class="scene-info-body">
                {sec.table ? (
                  <table class="scene-info-table">
                    {sec.table.map((row: string[], i: number) => (
                      <tr class={i === 0 ? 'scene-info-table-header' : ''}>
                        {row.map((cell: string) => (
                          <td set:html={cell} />
                        ))}
                      </tr>
                    ))}
                  </table>
                ) : (
                  <ul>
                    {getInfoLines(sec, lang).map((line: string) => (
                      <li set:html={line} />
                    ))}
                  </ul>
                )}
              </div>
            </div>
          ))}
        </div>
        <button
          class="scene-info-toggle"
          onclick="this.previousElementSibling.classList.toggle('expanded'); this.textContent = this.previousElementSibling.classList.contains('expanded') ? this.previousElementSibling.dataset.closeLabel : this.previousElementSibling.dataset.openLabel;"
        >{toggleOpen}</button>
      </div>
    )}

    <div data-pagefind-body style="display:none">{sceneTitle} {sceneDesc}</div>

    {hasGroups ? (
      <div class="rescue-landing-groups">
        {Object.entries(groups).map(([groupKey, groupSubs]) => {
          const firstSub = groupSubs[0];
          const groupLabel = firstSub[`group_${lang}`] || firstSub.group_zh || groupKey;
          return (
            <div class="rescue-landing-group">
              <div class="rescue-landing-group-title">{groupLabel}</div>
              <div class="rescue-landing-grid">
                {groupSubs.map((sub: any) => (
                  <a
                    href={`/${lang}/rescue/${scene.id}/${sub.id}/`}
                    class="rescue-landing-btn"
                  >
                    <span class="rescue-landing-btn-title">{getSubTitle(sub, lang)}</span>
                    <span class="rescue-landing-btn-ja">{sub.title_ja || ''}</span>
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="rescue-landing-grid">
        {subcats.map((sub: any) => (
          <a
            href={`/${lang}/rescue/${scene.id}/${sub.id}/`}
            class="rescue-landing-btn"
          >
            <span class="rescue-landing-btn-title">{getSubTitle(sub, lang)}</span>
            <span class="rescue-landing-btn-ja">{sub.title_ja || ''}</span>
          </a>
        ))}
      </div>
    )}
  </div>

</Base>
