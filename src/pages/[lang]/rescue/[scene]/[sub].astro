---
import Base from '../../../../layouts/Base.astro';
import RescueItem from '../../../../components/RescueItem.astro';
import rescueIndex from '../../../../../public/data/rescue/index.json';
import { readFile } from 'node:fs/promises';

export async function getStaticPaths() {
  const SUPPORTED_LANGS = ['zh-TW', 'en', 'vi', 'ko', 'ja'];
  const paths = [];
  for (const scene of rescueIndex.scenes) {
    if (!scene.subcategories || scene.subcategories.length === 0) continue;
    let sceneData;
    try {
      const raw = await readFile(`public/data/rescue/${scene.file.split('/').pop()}`, 'utf-8');
      sceneData = JSON.parse(raw);
    } catch (e) { continue; }
    for (const sub of scene.subcategories) {
      const items = (sceneData.items || []).filter((item: any) => item.subcategory === sub.id);
      for (const lang of SUPPORTED_LANGS) {
        paths.push({
          params: { lang, scene: scene.id, sub: sub.id },
          props: { scene, sub, items, lang }
        });
      }
    }
  }
  return paths;
}

const { scene, sub, items, lang } = Astro.props;

const sceneTitle = (scene as any)[`title_${lang}`] || (scene as any).title_zh || scene.title;
const subTitle = (sub as any)[`title_${lang}`] || sub.title;
const title = `${sceneTitle} · ${subTitle} | Living Japanese`;
const description = `${subTitle} - ${(scene as any)[`description_${lang}`] || scene.description || ''}`;

const homeUrl = `/${lang}/`;
const sceneUrl = `/${lang}/rescue/${scene.id}/`;

const homeLabel: Record<string, string> = {
  zh: '首页', en: 'Home', 'zh-TW': '首頁', vi: 'Trang chủ', ko: '홈', ja: 'ホーム'
};

const ui: Record<string, Record<string, string>> = {
  back:     { zh: '返回', en: 'Back', 'zh-TW': '返回', vi: 'Quay lại', ko: '돌아가기', ja: '戻る' },
  play:     { zh: '▶ 朗读', en: '▶ Play', 'zh-TW': '▶ 朗讀', vi: '▶ Đọc', ko: '▶ 읽기', ja: '▶ 朗読' },
  stop:     { zh: '■ 停止', en: '■ Stop', 'zh-TW': '■ 停止', vi: '■ Dừng', ko: '■ 정지', ja: '■ 停止' },
  ruby:     { zh: '注音', en: 'Kana', 'zh-TW': '注音', vi: 'Kana', ko: '후리', ja: 'ふりがな' },
  jp:       { zh: '仅日语', en: 'JP only', 'zh-TW': '僅日語', vi: 'Chỉ JP', ko: 'JP만', ja: '日本語のみ' },
  jp_zh:    { zh: '日→中', en: 'JP→EN', 'zh-TW': '日→中', vi: 'JP→VI', ko: 'JP→KO', ja: '日→中' },
  repeat:   { zh: '日→中→日', en: 'JP→EN→JP', 'zh-TW': '日→中→日', vi: 'JP→VI→JP', ko: 'JP→KO→JP', ja: '日→中→日' },
  normal:   { zh: '普通', en: 'Normal', 'zh-TW': '普通', vi: 'Bình thường', ko: '보통', ja: '普通' },
  slow:     { zh: '慢', en: 'Slow', 'zh-TW': '慢', vi: 'Chậm', ko: '느리게', ja: '遅い' },
  slower:   { zh: '更慢', en: 'Slower', 'zh-TW': '更慢', vi: 'Chậm hơn', ko: '더 느리게', ja: 'もっと遅い' },
  play_continuous: { zh: '连读', en: 'Continuous', 'zh-TW': '連讀', vi: 'Liên tục', ko: '연속 재생', ja: '連続再生' },
  play_follow3:    { zh: '3秒跟读', en: 'Follow (3s)', 'zh-TW': '3秒跟讀', vi: 'Lặp lại (3s)', ko: '3초 따라읽기', ja: '3秒リピート' },
  play_follow5:    { zh: '5秒跟读', en: 'Follow (5s)', 'zh-TW': '5秒跟讀', vi: 'Lặp lại (5s)', ko: '5초 따라읽기', ja: '5秒リピート' },
};

function u(key: string) { return ui[key]?.[lang] || ui[key]?.zh || key; }
---

<Base title={title} description={description} rescueCss={true}>

  <div id="pageData"
    data-scene-id={scene.id}
    data-sub-id={sub.id}
    data-lang={lang}
    data-play-label={u('play')}
    data-stop-label={u('stop')}
    data-l2-code={({zh:'ZH','zh-TW':'TW',en:'EN',vi:'VI',ko:'KO',ja:'JA'} as Record<string,string>)[lang] || 'ZH'}
    style="display:none">
  </div>

  <nav class="rescue-breadcrumb" aria-label="breadcrumb">
    <a href={homeUrl}>{homeLabel[lang] || homeLabel.zh}</a>
    <span aria-hidden="true">›</span>
    <a href={sceneUrl}>{sceneTitle}</a>
    <span aria-hidden="true">›</span>
    <span aria-current="page">{subTitle}</span>
  </nav>

  <div class="rescue-ctrl-bar" id="subCtrlBar">
    <a href={sceneUrl} class="ctrl-back" aria-label={u('back')}>←</a>
    <button onclick="togglePlay()" class="ctrl-play" id="btnPlay" aria-label={u('play')}>▶</button>
    <button onclick="toggleLoop()" class="ctrl-icon" id="btnLoop">🔁</button>
    <button onclick="toggleRuby()" class="ctrl-icon" id="btnRuby" aria-label={u('ruby')}>ふ</button>
    <button type="button" onclick="cyclePlayMode()" class="ctrl-cycle" id="btnPlayMode" aria-label="follow mode"></button>
    <button type="button" onclick="cycleMode()" class="ctrl-cycle" id="btnMode" aria-label="reading language"></button>
    <button type="button" onclick="cycleRate()" class="ctrl-cycle" id="btnRate" aria-label="speed"></button>
  </div>

  <div class="rescue-content-wrap" id="itemsWrap" data-pagefind-body>
    {items.map((item: any, idx: number) => (
      <RescueItem item={item} idx={idx} lang={lang} />
    ))}
  </div>

  <script src="/js/rescue-ui.js" is:inline></script>

</Base>