---
import Base from '../../layouts/Base.astro';
import rescueIndex from '../../../public/data/rescue/index.json';
import config from '../../../public/config.json';
import { readFile } from 'node:fs/promises';

export async function getStaticPaths() {
  const SUPPORTED_LANGS = ['zh-TW', 'en', 'vi', 'ko', 'ja'];
  return SUPPORTED_LANGS.map((lang) => ({
    params: { lang },
    props: { lang }
  }));
}

const { lang } = Astro.props;

// 实时统计每个场景的真实句子数（读取对话文件本身，不依赖index.json里手动维护的count字段）
const sceneCounts: Record<string, number> = {};
for (const scene of rescueIndex.scenes) {
  try {
    const raw = await readFile(`public/data/rescue/${scene.file.split('/').pop()}`, 'utf-8');
    const sceneData = JSON.parse(raw);
    sceneCounts[scene.id] = (sceneData.items || []).length;
  } catch (e) {
    sceneCounts[scene.id] = 0;
  }
}

const siteTitles: Record<string, string> = {
  zh: '日活 Living Japanese | 不是学日语，是习惯说日语',
  en: 'Living Japanese | Not studying Japanese. Making it a habit.',
  'zh-TW': '日活 Living Japanese | 不是學日語，是習慣說日語',
  vi: 'Living Japanese | Không phải học tiếng Nhật, mà là quen nói',
  ko: 'Living Japanese | 일본어를 배우는 게 아니라, 습관처럼 말하기',
  ja: '日活 Living Japanese | 日本語を学ぶのではなく、話す習慣を'
};

const siteDescs: Record<string, string> = {
  zh: '在日本看病、租房、办手续怎么用日语说？23个真实场景对话，真人核实，跟读练习，完全免费。',
  en: 'Real Japanese for hospital visits, apartment hunting, city hall, and driver license conversion in Japan. 23 verified scenes with two-way shadowing practice — completely free.',
  'zh-TW': '在日本看病、打工度假、辦手續怎麼用日語說？23個真實場景對話，真人核實，跟讀練習，完全免費。',
  vi: 'Đi khám bệnh, xin nghỉ phép, giải quyết tranh chấp lao động, thuê nhà, làm thủ tục hành chính ở Nhật phải nói tiếng Nhật thế nào? 23 tình huống hội thoại thật, có người kiểm chứng nội dung, luyện nói theo miễn phí hoàn toàn.',
  ko: '병원, 관공서, 은행, 워홀·유학 생활에서 일본어로 뭐라고 말해야 할지 막막할 때. 실제 검증된 23개 생활 상황 회화를 무료로 듣고 따라 말해보세요.',
  ja: '病院、市役所、賃貸契約など、日本の生活シーンで本当に使える日本語を。23の場面の実際の会話、シャドーイング練習付き、完全無料。'
};

const title = siteTitles[lang] || siteTitles.zh;
const description = siteDescs[lang] || siteDescs.zh;

function getSceneTitle(scene: any, lang: string): string {
  return scene[`title_${lang}`] || scene.title_zh || scene.title;
}

const countLabels: Record<string, string> = {
  zh: '句', en: ' phrases', 'zh-TW': '句', vi: ' câu', ko: '문장', ja: '文'
};

const scenes = rescueIndex.scenes;
const banner = config.banner;

const bannerTitle = (banner as any)[`title_${lang}`] || banner.title || '';
const bannerSubtitle = (banner as any)[`subtitle_${lang}`] || banner.subtitle || '';
const bannerPills = (banner as any)[`pills_${lang}`] || banner.pills || [];

const bannerStatLabels: Record<string, string> = {
  zh: '句・完全免费', 'zh-TW': '句・完全免費',
  en: 'phrases · free', vi: 'câu · miễn phí', ko: '문장 · 무료',
  ja: '文・完全無料'
};

// banner下方"了解我们为什么做这个网站"文字链接
const aboutLinkLabels: Record<string, string> = {
  zh: '了解我们为什么做这个网站 →',
  'zh-TW': '了解我們為什麼做這個網站 →',
  en: 'Why we built this site →',
  vi: 'Vì sao chúng tôi làm trang web này →',
  ko: '우리가 이 사이트를 만든 이유 →',
  ja: 'このサイトを作った理由 →'
};
const aboutLinkLabel = (aboutLinkLabels as any)[lang] || aboutLinkLabels.zh;

const shadowingLabels: Record<string, { title: string; body: string }> = {
  zh:     { title: '跟读练习', body: '🎧 连续播放、3秒等你跟读、5秒等你跟读——日本人怎么问、你怎么答，两边角色都能练到嘴里说出来。' },
  en:     { title: 'Shadowing Practice', body: '🎧 Continuous playback, or pause 3s / 5s for you to repeat — practice both sides of the conversation until it becomes second nature.' },
  'zh-TW':{ title: '跟讀練習', body: '🎧 連續播放、3秒等你跟讀、5秒等你跟讀——日本人怎麼問、你怎麼答，兩邊角色都能練到嘴裡說出來。' },
  vi:     { title: 'Luyện tập theo (Shadowing)', body: '🎧 Phát liên tục, hoặc dừng 3 giây / 5 giây để bạn lặp lại — luyện cả hai vai trong hội thoại đến khi nói ra tự nhiên.' },
  ko:     { title: '쉐도잉 연습', body: '🎧 연속 재생, 3초 대기, 5초 대기 중 선택 — 일본인이 묻는 말과 내가 답하는 말, 양쪽 다 입에 붙을 때까지 연습하세요.' },
  ja:     { title: 'シャドーイング練習', body: '🎧 連続再生、3秒待って復唱、5秒待って復唱——相手のセリフも自分のセリフも、両方口に出して練習できます。' }
};
const shadowing = shadowingLabels[lang] || shadowingLabels.zh;
---

<Base title={title} description={description} rescueCss={true}>

  <div class="rescue-scene-wrap" data-pagefind-body>

  <div id="banner" class="banner-wrap">
    <div class="banner-inner">
      <div class="banner-left">
        <div class="banner-eyebrow">{banner.eyebrow || ''}</div>
        <div class="banner-title">{bannerTitle}</div>
        {bannerSubtitle && <div class="banner-subtitle">{bannerSubtitle}</div>}
        <div class="banner-pills">
          {bannerPills.map((pill: string) => (
            <span class="banner-pill">{pill}</span>
          ))}
        </div>
      </div>
      <div class="banner-right">
        <div class="banner-stat-num">
          {scenes.reduce((total: number, sc: any) => total + (sceneCounts[sc.id] || 0), 0)}
        </div>
        <div class="banner-stat-label">
          {bannerStatLabels[lang] || bannerStatLabels.zh}
        </div>
      </div>
    </div>
    <div class="banner-shadowing">
      <span class="banner-shadowing-title">{shadowing.title}</span>
      <span class="banner-shadowing-body">{shadowing.body}</span>
    </div>
    <a href="/about/" class="banner-about-link">{aboutLinkLabel}</a>
  </div>

{(() => {
  const categories = [
    { id: 'daily',     zh: '日常必備', en: 'Essentials',    'zh-TW': '日常必備', vi: 'Cơ bản',      ko: '일상 필수',   ja: '日常必須',   icon: '📌' },
    { id: 'medical',   zh: '医疗健康', en: 'Medical',        'zh-TW': '醫療健康', vi: 'Y tế',         ko: '의료 건강',   ja: '医療・健康', icon: '🏥' },
    { id: 'living',    zh: '生活居住', en: 'Daily Life',     'zh-TW': '生活居住', vi: 'Cuộc sống',    ko: '생활 거주',   ja: '生活・居住', icon: '🏠' },
    { id: 'transport', zh: '出行交通', en: 'Transport',      'zh-TW': '出行交通', vi: 'Di chuyển',    ko: '교통 이동',   ja: '交通・移動', icon: '🚗' },
    { id: 'shopping',  zh: '购物饮食', en: 'Shopping',       'zh-TW': '購物飲食', vi: 'Mua sắm',      ko: '쇼핑 음식',   ja: '買い物・飲食', icon: '🛍️' },
    { id: 'work',      zh: '工作学校', en: 'Work & School',  'zh-TW': '工作學校', vi: 'Công việc',    ko: '일 학교',     ja: '仕事・学校', icon: '💼' },
    { id: 'leisure',   zh: '文化休闲', en: 'Leisure',        'zh-TW': '文化休閒', vi: 'Giải trí',     ko: '문화 여가',   ja: '文化・レジャー', icon: '🎌' },
    { id: 'emergency', zh: '紧急灾害', en: 'Emergency',      'zh-TW': '緊急災害', vi: 'Khẩn cấp',     ko: '긴급 재해',   ja: '緊急・災害', icon: '🆘' },
  ];

  return (
    <div class="rescue-scene-wrap">
      {categories.map(cat => {
        const catScenes = scenes.filter((s: any) => s.category === cat.id);
        if (catScenes.length === 0) return null;
        const catLabel = (cat as any)[lang] || cat.zh;
        return (
          <div class="rescue-category-group">
            <div class="rescue-category-title">
              <span class="rescue-category-icon">{cat.icon}</span>
              <span>{catLabel}</span>
            </div>
            <div class="rescue-scene-grid">
              {catScenes.map((scene: any) => {
                const sceneTitle = getSceneTitle(scene, lang);
                const sceneUrl = `/${lang}/rescue/${scene.id}/`;
                const count = sceneCounts[scene.id] || 0;
                const countLabel = countLabels[lang] || countLabels.zh;
                return (
                  <a href={sceneUrl} class="rescue-scene-card">
                    {scene.image && (
                      <div class="rescue-scene-bg" style={`background-image:url('/${scene.image}')`}></div>
                    )}
                    <div class="rescue-scene-overlay"></div>
                    <div class="rescue-scene-content">
                      <div class="rescue-scene-title">{sceneTitle}</div>
                      <div class="rescue-scene-count">{count}{countLabel}</div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>
  );
})()}
</div>
</Base>