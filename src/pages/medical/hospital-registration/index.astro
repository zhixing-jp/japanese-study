---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SECTIONS } from '../../../data/sections';
import { readFile } from 'node:fs/promises';
import disclaimer from '../../../../public/data/medical/disclaimer.json';

const lang = 'zh';

let pageData: any = { sections: [] };
try {
  const raw = await readFile('public/data/medical/hospital-registration.json', 'utf-8');
  pageData = JSON.parse(raw);
} catch (e) {
  pageData = { sections: [] };
}

function tf(obj: any, field: string, lang: string): string {
  return obj[`${field}_${lang}`] || obj[field] || obj[`${field}_zh`] || '';
}
---

<Base title={`${pageData.title || '挂号话术与流程'} | Living Japanese · 日活`} description={pageData.description || ''} medicalCss={true}>

  <Breadcrumb crumbs={[{ label: SECTIONS.medical.label, url: SECTIONS.medical.url }, { label: pageData.title }]} cssClass="med-breadcrumb" />

  <p class="med-disclaimer">{disclaimer.page_full.zh}</p>

  <div class="med-action-page" id="medActionPage">
    <h1 class="med-action-title">{pageData.title}</h1>

    {(pageData.sections || []).map((section: any) => (
      <section class="med-action-section">
        <h2 class="med-action-section-title">{section.title}</h2>

        {(section.items || []).map((item: any) => (
          <div
            class={`med-action-card med-action-card--${item.type} ${item.role ? `is-${item.role}` : ''}`}
            data-type={item.type}
            data-jp={item.jp || ''}
          >
            {item.type !== 'instruction' && (
              <>
                <div class="med-action-jp">{item.jp}</div>
                <div class="med-action-furigana">{item.furigana}</div>
                <button class="med-action-play-btn" data-jp={item.jp} aria-label="朗读">▶</button>
              </>
            )}
            <div class="med-action-translated">{tf(item, 'zh', lang)}</div>
            {item.note && <div class="med-action-note">{item.note}</div>}
          </div>
        ))}
      </section>
    ))}
  </div>

  <div data-pagefind-body style="display:none">{pageData.title} {pageData.description}</div>

  <script is:inline src="/js/tts-core.js"></script>
  <script is:inline src="/js/medical-ui.js"></script>
  <script is:inline>
    (function () {
      function init() {
        if (!window.medicalUI) return;
        document.querySelectorAll('.med-action-play-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const jp = btn.getAttribute('data-jp');
            if (!jp) return;
            window.medicalUI.speakItem({ type: 'phrase', jp: jp });
          });
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else { init(); }
    })();
  </script>

</Base>