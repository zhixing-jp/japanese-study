---
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SECTIONS } from '../../../data/sections';
import { readFile } from 'node:fs/promises';
import disclaimer from '../../../../public/data/medical/disclaimer.json';

let pageData: any = { sections: [] };
try {
  const raw = await readFile('public/data/medical/special-groups.json', 'utf-8');
  pageData = JSON.parse(raw);
} catch (e) {
  pageData = { sections: [] };
}
---

<Base title={`${pageData.title || '特殊人群速查'} | Living Japanese · 日活`} description={pageData.description || ''} medicalCss={true}>

  <Breadcrumb crumbs={[{ label: SECTIONS.medical.label, url: SECTIONS.medical.url }, { label: pageData.title }]} cssClass="med-breadcrumb" />

  <p class="med-disclaimer">{disclaimer.page_full.zh}</p>

  <div class="med-ref-page" id="medRefPage">
    <h1>{pageData.title}</h1>

    {pageData.verified_note && (
      <div class="med-ref-verified-note">
        内容核实于 {pageData.verified_note.verified_date}，来源：{(pageData.verified_note.sources || []).join('、')}
      </div>
    )}

    <nav class="med-ref-anchor-nav">
      {(pageData.sections || []).map((s: any) => (
        <a href={`#${s.id}`}>{s.heading}</a>
      ))}
    </nav>

    {(pageData.sections || []).map((section: any) => (
      <div class="med-ref-section" id={section.id}>
        <h2 class="med-ref-section-heading">
          {section.heading}
          {section.uncertain && <span class="med-ref-uncertain-tag">⚠️ 待核实/持续更新</span>}
        </h2>
        <div class="med-ref-body">{section.body_zh}</div>
      </div>
    ))}
  </div>

  <div data-pagefind-body style="display:none">{pageData.title} {pageData.description}</div>

</Base>