---
import Base from '../../layouts/Base.astro';
import medicalIndex from '../../../public/data/medical/index.json';
import disclaimer from '../../../public/data/medical/disclaimer.json';

const lang = 'zh';

const titles: Record<string, string> = {
  action: '现场执行', tool: '症状指认词库', reference: '医疗制度与常见问题'
};

const groups: Record<string, any[]> = { action: [], tool: [], reference: [] };
for (const p of medicalIndex.pages) {
  (groups[p.group] || (groups[p.group] = [])).push(p);
}
---

<Base title="就医指南 | Living Japanese · 日活" description="在日本看病，从制度认知到现场沟通，中文一站式指南，真人核实，可跟读练习。" medicalCss={true}>

  <div class="med-hub-page" id="medHubPage">
    <h1>就医指南</h1>
    <p class="med-hub-intro">流程细节，来自20年在日经验人工核实；关键词句都能跟读发音；遇到拿不准的情况，有真人可以直接帮你判断。</p>
    <p class="med-disclaimer">{disclaimer.hub_short.zh}</p>

    {Object.entries(groups).map(([groupKey, pages]) => (
      pages.length > 0 && (
        <section class="med-hub-group">
          <h2>{titles[groupKey] || groupKey}</h2>
          <div class="med-hub-nav-grid">
            {pages.map((p: any) => (
              <a href={p.url} class={`med-hub-nav-card med-hub-nav-card--${groupKey}`}>
                <div class="med-hub-nav-card-title">{p.title}</div>
                <div class="med-hub-nav-card-desc">{p.description}</div>
              </a>
            ))}
          </div>
        </section>
      )
    ))}
  </div>

  <div data-pagefind-body style="display:none">就医指南 在日本看病 挂号 保险 症状 中文</div>

</Base>