---
interface RubySegment {
  text: string;
  isKanji: boolean;
  reading?: string;
}

interface Props {
  item: {
    jp: string;
    ruby?: RubySegment[];
    furigana_flat?: string;
    zh?: string;
    en?: string;
    'zh-TW'?: string;
    vi?: string;
    ko?: string;
    role?: string;
    id?: string;
  };
  idx: number;
  lang: string;
}

const { item, idx, lang } = Astro.props;
const isStaff = item.role === 'staff';

function getText(item: Props['item'], lang: string): string {
  if (lang === 'en') return item.en || item.zh || '';
  if (lang === 'zh-TW') return item['zh-TW'] || item.zh || '';
  if (lang === 'vi') return item.vi || item.zh || '';
  if (lang === 'ko') return item.ko || item.zh || '';
  return item.zh || '';
}

const labels: Record<string, Record<string, string>> = {
  staff: {
    zh: '对方可能会问', en: 'Staff may ask',
    'zh-TW': '對方可能會問', vi: 'Nhân viên có thể hỏi', ko: '직원이 물어볼 수 있어요'
  },
  speak: { zh: '▶ 朗读', en: '▶ Listen', 'zh-TW': '▶ 朗讀', vi: '▶ Nghe', ko: '▶ 듣기' }
};

const text = getText(item, lang);
const staffLabel = labels.staff[lang] || labels.staff.zh;
const btnLabel = labels.speak[lang] || labels.speak.zh;

// ruby HTML 生成：直接遍历数据层已经分好段的 ruby 数组，不做任何字符串搜索/
// 猜测。每段是否含汉字、读音是什么，在生成数据阶段（kuromoji分词 / 人工核实）
// 就已经精确确定，渲染层只负责按结构原样拼出 HTML，不存在边界误判的可能。
function buildRubyHtml(item: Props['item']): string {
  if (!item.ruby || item.ruby.length === 0) return item.jp;
  let html = '';
  for (const seg of item.ruby) {
    if (seg.isKanji && seg.reading) {
      html += `<ruby>${seg.text}<rt>${seg.reading}</rt></ruby>`;
    } else {
      html += seg.text;
    }
  }
  return html;
}

const rubyHtml = buildRubyHtml(item);
// 供朗读功能等需要"纯假名字符串"的场景使用（兼容旧的 data-furigana 用法）
const furiganaFlat = item.furigana_flat || item.jp;
---

<div
  class={`card${isStaff ? ' is-staff' : ''}`}
  id={`card-${idx}`}
  data-idx={idx}
  data-jp={item.jp}
  data-furigana={furiganaFlat}
  data-text={text}
  data-role={item.role || 'user'}
>
  {isStaff && <span class="staff-label">{staffLabel}</span>}

  <div class="card-top">
    <div class="card-num">{idx + 1}</div>
    <div class="card-btns-top">
      <button
        class={`card-play-btn${isStaff ? ' is-staff-btn' : ''}`}
        onclick={`speakItem(${idx})`}
        aria-label={btnLabel}
      >{btnLabel}</button>
    </div>
  </div>

  <div class="jp" set:html={rubyHtml} />
  <div class="zh">{text}</div>
</div>